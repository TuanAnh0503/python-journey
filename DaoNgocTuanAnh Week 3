        print("Số tiền phải là bội số của 50,000")
    else:
        so_du -= so_tien
        print("Rút tiền thành công")
        print("Số dư còn lại:", so_du)


# TODO 2: Xếp loại BMI
chieu_cao = float(input("\nNhập chiều cao (m): "))
can_nang = float(input("Nhập cân nặng (kg): "))

bmi = can_nang / (chieu_cao ** 2)
print("BMI của bạn:", round(bmi, 2))

if bmi < 18.5:
    print("Thiếu cân - Hãy ăn uống đầy đủ và chăm sóc sức khỏe")
elif bmi < 25:
    print("Bình thường - Hãy duy trì lối sống lành mạnh")
elif bmi < 30:
    print("Thừa cân - Nên chú ý chế độ ăn uống và vận động")
else:
    print("Béo phì - Nên tham khảo ý kiến bác sĩ")


# TODO 3: Máy bán vé xem phim
loai_ve = input("\nLoại vé (thuong/vip): ").lower()
ngay = input("Ngày (thuong/cuoi_tuan): ").lower()
tuoi = int(input("Tuổi: "))

if loai_ve == "thuong":
    gia = 80000
else:
    gia = 120000

if ngay == "cuoi_tuan":
    gia *= 1.3

if tuoi < 12 or tuoi >= 65:
    gia *= 0.5
elif 18 <= tuoi <= 25:
    gia *= 0.8

print("Giá vé cuối cùng:", int(gia), "VNĐ")
