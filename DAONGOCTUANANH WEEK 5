"""Exercise 01: list create, read, update and delete."""

subjects = ["Toán", "Văn", "Anh"]

# TODO: append one subject and insert another at index 1.
# Hàm hỗ trợ in phần tử đầu, phần tử cuối và phần giữa (middle slice)
def print_elements(lst):
    if not lst:
        print("Danh sách rỗng!")
        return
    
    first = lst[0]
    last = lst[-1]
    # Lấy các phần tử ở giữa (bỏ phần tử đầu và cuối)
    middle = lst[1:-1]
    
    print(f"Danh sách hiện tại: {lst}")
    print(f"- Đầu: {first}")
    print(f"- Cuối: {last}")
    print(f"- Phần giữa: {middle}")
    print("-" * 30)

print("--- Trạng thái ban đầu ---")
print_elements(subjects)
# TODO: update the first subject.
subjects.append("Ly")
subjects.insert("Su")
print('Su',subjects.insert,'Ly',subjects.append)
print_elements(subjects)
# TODO: remove one known subject and pop the last subject.
if 'Văn' in subjects:   
    subjects.remove('Văn')
print("Sau khi go mon Văn")
print_elements(subjects)
# TODO: print the first, last and middle slice after each safe operation.
if subjects:  
    popped_item = subjects.pop()
    print(f"--- Sau khi pop môn cuối ('{popped_item}') ---")
    print_elements(subjects)


print(subjects)
