  """Exercise 04: a small regular-expression lab."""

import re

text = "Tickets PJ-101 and PJ-205 are open; XX-999 is unrelated."

# TODO 1: Lấy các mã PJ-xxx
codes = re.findall(r"PJ-\d{3}", text)

# TODO 2: Tìm chuỗi số đầu tiên
first_number = re.search(r"\d+", text)

if first_number:
    first_number = first_number.group()

# TODO 3: Kiểm tra W + đúng 2 chữ số
candidate = "W04"
is_week_code = bool(re.fullmatch(r"W\d{2}", candidate))

print(codes)
print(first_number)
print(is_week_code)
