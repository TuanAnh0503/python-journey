# TODO 5: Mã hóa Caesar
chuoi = input("\nNhập chuỗi: ")
shift = int(input("Nhập số bước dịch: "))

ket_qua = ""

for c in chuoi:
    if c.isalpha():
        if c.islower():
            ket_qua += chr((ord(c) - ord('a') + shift) % 26 + ord('a'))
        else:
            ket_qua += chr((ord(c) - ord('A') + shift) % 26 + ord('A'))
    else:
        ket_qua += c

print("Chuỗi sau mã hóa:", ket_qua)
